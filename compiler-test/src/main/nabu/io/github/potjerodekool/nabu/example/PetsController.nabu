package io.github.potjerodekool.nabu.example;

import io.github.potjerodekool.PetDto;

import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

import java.util.List;
import java.util.ArrayList;
import java.util.UUID;
import java.util.Optional;
import java.util.stream.Collectors;

@RestController
@RequestMapping(value = {"/v1/pets"})
public class PetsController {

    private petRepository : PetRepository;
    private categoryRepository : CategoryRepository;

    public PetsController(final petRepository : PetRepository,
                          final categoryRepository : CategoryRepository) {
        this.petRepository = petRepository;
        this.categoryRepository = categoryRepository;

        final var tweety = new Pet();
        tweety.setName("Tweety");
        petRepository.save(tweety);

        final var sylvester = new Pet();
        sylvester.setName("Sylvester J. Pussycat Sr.");
        petRepository.save(sylvester);
    }

    @GetMapping
    public fun getPets(): List<PetDto> {
        final var result = this.petRepository.findAll();
        final var resultList = new ArrayList<PetDto>();

        for (var i = 0; i < result.size(); i++) {
            final var pet : Pet = (Pet) result.get(i);
            final var petDto = this.mapToDto(pet);
            resultList.add(petDto);
        }

        return resultList;
    }

    private fun mapToDto(pet: Pet): PetDto {
        final var id = pet.getId();
        final var name = pet.getName();

        final var petDto = new PetDto();
        petDto.setId(id);
        petDto.setName(name);
        return petDto;
    }

    private fun toEntity(final dto: PetDto): Pet {
        final var categoryDto = dto.getCategory();
        final var category = this.categoryRepository.findById(categoryDto.getId())
            .get();

        final var pet = new Pet();
        pet.setCategory(category);
        pet.setName(dto.getName());
        return pet;
    }
}