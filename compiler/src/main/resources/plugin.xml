<?xml version="1.0" encoding="UTF-8"?>
<plugin>
    <id>io.github.potjerodekool.nabu.compiler</id>
    <version>0.0.1</version>
    <description>Compiler support for Nabu language</description>
    <extensions>
        <language-support
                implementationClass="io.github.potjerodekool.nabu.compiler.lang.support.java.JavaLanguageSupport"/>
        <language-support
                implementationClass="io.github.potjerodekool.nabu.compiler.lang.support.kotlin.KotlinLanguageSupport"/>
        <backend implementationClass="io.github.potjerodekool.nabu.compiler.backend.asm.AsmBackend" name="ASM"/>
    </extensions>
</plugin>